# ==============================================================================
# 🔐 SECRETS & ENVIRONMENT VARIABLES (NEVER COMMIT THESE)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

# Allow committing an example file to show the team what keys are needed
!.env.example

# ==============================================================================
# 📦 DEPENDENCIES & PACKAGE MANAGERS
# ==============================================================================
# Node.js
node_modules/
jspm_packages/

# Python (if backend uses Python)
venv/
.venv/
env/
__pycache__/
*.py[cod]

# ==============================================================================
# 🚀 BUILD OUTPUTS & CACHES
# ==============================================================================
# Generic build/dist folders
dist/
build/
out/

# Next.js
.next/

# Nuxt.js
.nuxt/

# Remix
.cache/

# Vite
*.local

# TS / JS caches
.eslintcache
.stylelintcache
.prettiercache
.tsbuildinfo

# ==============================================================================
# 🗄️ DATABASES & LOCAL STORAGE
# ==============================================================================
# SQLite
*.db
*.db-journal
*.sqlite

# Prisma
/prisma/dev.db
/prisma/dev.db-journal

# Local Docker database volumes
.docker/data/

# ==============================================================================
# 🛠️ IDE, EDITORS & SYSTEM FILES
# ==============================================================================
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# WebStorm / IntelliJ / JetBrains
.idea/

# Mac / Apple OS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
